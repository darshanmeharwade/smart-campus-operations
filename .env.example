# Set a long, random value before deployment to keep sessions valid across restarts.
SECRET_KEY=replace-with-a-long-random-secret

# Optional: defaults to instance/campus.db
DATABASE_PATH=instance/campus.db

# Set true when serving over HTTPS. Keep false for local HTTP development.
SESSION_COOKIE_SECURE=false

# Optional local development settings
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
